# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (local dev only). For production set this to your Postgres URL.
# Render/Railway provide this automatically when you attach a Postgres database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── CORS / Allowed Origins (comma-separated) ──────────────────────────────────
# Add your deployed frontend URL here (e.g. your Vercel/Netlify URL or custom domain)
# ALLOWED_ORIGINS=https://formiq.app,https://your-app.vercel.app
